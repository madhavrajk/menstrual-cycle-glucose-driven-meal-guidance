# Copy to .env and fill in. .env is gitignored.

# Folder that contains data/raw/<mcPHASES zip> and data/processed/.
# Keep it OUTSIDE OneDrive so participant data is never synced to the cloud.
# Leave unset to use this repo's own data/ folder.
MCPHASES_HOME=~/mcphases

# USDA FoodData Central API key (Step 3)
FDC_API_KEY=
